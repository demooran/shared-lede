# Target
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_ramips_mt7621_DEVICE_xiaomi_mi-router-cr6609=y

# ==========================================
# LuCI Core & Base (أساسيات الواجهة - مهم جداً)
# ==========================================
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-lua-runtime=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_LUCI_JSMIN=y
CONFIG_LUCI_CSSTIDY=y

# ==========================================
# LuCI Modules (الوحدات الأساسية)
# ==========================================
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-system=y

# ==========================================
# Wireless & Mesh Support (دعم التشفير والـ Mesh)
# ==========================================
CONFIG_PACKAGE_kmod-mac80211=y
CONFIG_PACKAGE_kmod-cfg80211=y
CONFIG_PACKAGE_wpad-openssl=y
CONFIG_PACKAGE_iw=y
CONFIG_PACKAGE_batctl=y
CONFIG_PACKAGE_kmod-batman-adv=y

# ==========================================
# LuCI Applications (التطبيقات المطلوبة والـ Mesh)
# ==========================================
CONFIG_PACKAGE_luci-app-mesh=y
CONFIG_PACKAGE_libustream-openssl=y

# ==========================================
# Languages (الإنجليزية فقط)
# ==========================================
CONFIG_PACKAGE_luci-i18n-base-en=y

# ==========================================
# SSH Service
# ==========================================
CONFIG_PACKAGE_dropbear=y

# ==========================================
# Themes (ثيم أرجون)
# ==========================================
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_LUCI_DEFAULT_THEME="argon"

# ==========================================
# Additional Apps (التطبيقات الإضافية)
# ==========================================
CONFIG_PACKAGE_luci-app-lldpd=y
CONFIG_PACKAGE_luci-app-watchcat=y
CONFIG_PACKAGE_luci-app-vlanwizard=y

# Target
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_ramips_mt7621_DEVICE_xiaomi_mi-router-cr6609=y

# ==========================================
# LuCI Core & Modules (الواجهة الأساسية والوحدات)
# ==========================================
CONFIG_PACKAGE_luci-light=y
CONFIG_LUCI_JSMIN=y
CONFIG_LUCI_CSSTIDY=y

# الوحدات الأساسية
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_wifi-scripts=y
CONFIG_PACKAGE_ubus=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_iwinfo=y

# ==========================================
# Wireless & Mesh Support (دعم التشفير والـ Mesh)
# ==========================================
CONFIG_PACKAGE_kmod_mac80211=y
CONFIG_PACKAGE_wpad-openssl=y

# ==========================================
# LuCI Applications (التطبيقات المطلوبة والـ Mesh)
# ==========================================
CONFIG_PACKAGE_luci-app-lldpd=y
CONFIG_PACKAGE_luci-app-mesh=y

# ==========================================
# Languages (الإنجليزية فقط)
# ==========================================
CONFIG_PACKAGE_luci-i18n-base-en=y

# ==========================================
# SSH Service (لإبقاء SSH يعمل في الخلفية)
# ==========================================
CONFIG_PACKAGE_dropbear=y

# ==========================================
# Themes (الثيمات - ثيم أرجون وتفعيله افتراضياً)
# ==========================================
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_LUCI_DEFAULT_THEME="argon"
CONFIG_PACKAGE_luci-lua-runtime=y
CONFIG_PACKAGE_luci-compat=y

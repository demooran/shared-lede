# Target
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7620=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_ramips_mt7620_DEVICE_phicomm_k2-v22.4=y
CONFIG_TARGET_DEVICE_ramips_mt7620_DEVICE_phicomm_k2-v22.5=y

# ==========================================
# LuCI Core & Modules (الأساسيات)
# ==========================================
CONFIG_PACKAGE_luci-light=y
CONFIG_LUCI_JSMIN=y
CONFIG_LUCI_CSSTIDY=y

CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_wpad-basic-mbedtls=y
CONFIG_PACKAGE_wifi-scripts=y
CONFIG_PACKAGE_ubus=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-system=y

# ==========================================
# LuCI Applications (فقط ما تحتاجه)
# ==========================================
CONFIG_PACKAGE_luci-app-quicksetup=y
# تم إزالة luci-app-firewall و lldpd لتوفير المساحة

# ==========================================
# Themes (ثيم واحد فقط)
# ==========================================
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-lua-runtime=y
CONFIG_PACKAGE_luci-compat=y

# ==========================================
# Languages (الإنجليزية فقط)
# ==========================================
CONFIG_PACKAGE_luci-i18n-base-en=y
# تم إزالة باقي اللغات

# ==========================================
# SSH Service (لإبقاء SSH يعمل في الخلفية)
# ==========================================
CONFIG_PACKAGE_dropbear=y

# ==========================================
# DNS (استخدام dnsmasq العادي بدلاً من full)
# ==========================================
CONFIG_PACKAGE_dnsmasq=y
# CONFIG_PACKAGE_dnsmasq-full=y  <-- معطل

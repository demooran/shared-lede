# Target
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7620=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_ramips_mt7620_DEVICE_phicomm_k2-v22.4=y
CONFIG_TARGET_DEVICE_ramips_mt7620_DEVICE_phicomm_k2-v22.5=y

# ==========================================
# LuCI Core & Modules (الواجهة الأساسية والوحدات)
# ==========================================
CONFIG_PACKAGE_luci-light=y
CONFIG_LUCI_JSMIN=y
CONFIG_LUCI_CSSTIDY=y

# الوحدات الأساسية (بدون mod-admin-full)
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-system=y

# ==========================================
# LuCI Applications (التطبيقات المطلوبة)
# ==========================================
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-lldpd=y

# ==========================================
# Themes (الثيمات - ثيم واحد فقط)
# ==========================================
CONFIG_PACKAGE_luci-theme-argon=y

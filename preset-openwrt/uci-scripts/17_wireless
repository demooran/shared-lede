#!/bin/sh

uci -q batch << EOF

# 1. تفعيل كروت الواي فاي للراديو الأول والثاني
set wireless.@wifi-device[0].disabled=0
set wireless.@wifi-device[1].disabled=0

# 2. تعيين القنوات على الوضع التلقائي
set wireless.@wifi-iface[0].channel=auto
set wireless.@wifi-iface[1].channel=auto

# 3. ضبط قوة الإرسال القصوى لاستقرار وتغطية قوية (30 dBm)
set wireless.@wifi-device[0].txpower=38
set wireless.@wifi-device[1].txpower=30

# 4. حذف قيود الدولة لفتح أقصى أداء متاح
delete wireless.@wifi-device[0].country
delete wireless.@wifi-device[1].country

commit wireless

EOF

exit 0

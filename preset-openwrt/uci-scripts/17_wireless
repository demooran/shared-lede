#!/bin/sh

uci -q batch << EOF

# 1. تفعيل كروت الواي فاي للراديو الأول والثاني
set wireless.@wifi-device[0].disabled=0
set wireless.@wifi-device[1].disabled=0

# 2. تعيين القنوات على الوضع التلقائي
set wireless.@wifi-iface[0].channel=auto
set wireless.@wifi-iface[1].channel=auto

# 3. إزالة قيود الدولة وتعيين كود مفتوح لفتح السقف
set wireless.@wifi-device[0].country='US'
set wireless.@wifi-device[1].country='US'

# 4. ضبط قوة الإرسال الوهمية/المعروضة على 36 dBm لكي تظهر في الواجهة
set wireless.@wifi-device[0].txpower=36
set wireless.@wifi-device[1].txpower=36

commit wireless

EOF

# إعادة تحميل خدمة الواي فاي لتطبيق القيم فوراً
wifi reload

exit 0
